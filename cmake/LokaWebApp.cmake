# Definitions only: safe to include on native platforms.
get_filename_component(LOKA_WEB_RAIL_DIR "${CMAKE_CURRENT_LIST_DIR}/../web" ABSOLUTE)

get_filename_component(LOKA_WEB_REPOSITORY_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

# Encode one scalar, never a CMake list. CMake strings cannot contain NUL.
function(_loka_web_json_string OUT VALUE)
  string(REPLACE "\\" "\\\\" VALUE "${VALUE}")
  string(REPLACE "\"" "\\\"" VALUE "${VALUE}")
  foreach(_code RANGE 1 31)
    string(ASCII ${_code} _control)
    if(_code EQUAL 8)
      set(_escape "b")
    elseif(_code EQUAL 9)
      set(_escape "t")
    elseif(_code EQUAL 10)
      set(_escape "n")
    elseif(_code EQUAL 12)
      set(_escape "f")
    elseif(_code EQUAL 13)
      set(_escape "r")
    else()
      string(FIND "${VALUE}" "${_control}" _found)
      if(NOT _found EQUAL -1)
        message(FATAL_ERROR "Web catalog: unsupported control character ${_code}")
      endif()
      continue()
    endif()
    string(REPLACE "${_control}" "\\${_escape}" VALUE "${VALUE}")
  endforeach()
  set(${OUT} "\"${VALUE}\"" PARENT_SCOPE)
endfunction()

# The configure-known output specification is shared by application and validation.
function(_loka_web_output_spec EXPORT_NAME OUTPUT_DIR)
  set(_output_properties OUTPUT_NAME RUNTIME_OUTPUT_DIRECTORY PREFIX SUFFIX PARENT_SCOPE)
  set(_OUTPUT_NAME "${EXPORT_NAME}" PARENT_SCOPE)
  set(_RUNTIME_OUTPUT_DIRECTORY "${OUTPUT_DIR}" PARENT_SCOPE)
  set(_PREFIX "" PARENT_SCOPE)
  set(_SUFFIX ".js" PARENT_SCOPE)
endfunction()

# One property per scalar preserves semicolons, including in directory names.
# The count and indexed rows belong only to this configure's catalog producer.
function(_loka_web_register TARGET EXPORT_NAME OUTPUT_DIR)
  file(RELATIVE_PATH _source "${LOKA_WEB_REPOSITORY_ROOT}" "${CMAKE_CURRENT_SOURCE_DIR}")
  if(NOT _source MATCHES "^example/.")
    return()
  endif()
  get_property(_count GLOBAL PROPERTY LOKA_WEB_APP_COUNT)
  if(NOT _count)
    set(_count 0)
  endif()
  math(EXPR _count "${_count} + 1")
  set_property(GLOBAL PROPERTY LOKA_WEB_APP_COUNT "${_count}")
  set_property(GLOBAL PROPERTY LOKA_WEB_APP_${_count}_target "${TARGET}")
  set_property(GLOBAL PROPERTY LOKA_WEB_APP_${_count}_exportName "${EXPORT_NAME}")
  set_property(GLOBAL PROPERTY LOKA_WEB_APP_${_count}_sourceDir "${_source}")
  set_property(GLOBAL PROPERTY LOKA_WEB_APP_${_count}_outputDir "${OUTPUT_DIR}")
endfunction()

function(_loka_web_relative_path VALUE)
  if("${VALUE}" STREQUAL "" OR IS_ABSOLUTE "${VALUE}"
      OR "${VALUE}" MATCHES "(^|/)\\.\\.(/|$)|\\\\|^[A-Za-z]:|\\$<")
    message(FATAL_ERROR "Web catalog: invalid relative path: ${VALUE}")
  endif()
endfunction()

# Call once after the Web graph is complete. Validate before publishing anything.
function(loka_finalize_web_apps)
  if(CMAKE_CONFIGURATION_TYPES)
    message(FATAL_ERROR "Web catalog: single-configuration builds only")
  endif()
  set(_catalog "{\"version\":1,\"apps\":[")
  set(_separator "")
  get_property(_count GLOBAL PROPERTY LOKA_WEB_APP_COUNT)
  if(_count)
    foreach(_index RANGE 1 ${_count})
      foreach(_field target exportName sourceDir outputDir)
        get_property(_${_field} GLOBAL PROPERTY LOKA_WEB_APP_${_index}_${_field})
      endforeach()
      if(NOT _target MATCHES "^[A-Za-z0-9_]+$")
        message(FATAL_ERROR "Web catalog: invalid target name")
      endif()
      if(NOT _exportName MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Web catalog: invalid export name")
      endif()
      if(DEFINED _seen_${_target})
        message(FATAL_ERROR "Web catalog: duplicate identity: ${_target}")
      endif()
      set(_seen_${_target} TRUE)
      _loka_web_relative_path("${_sourceDir}")
      if(NOT _sourceDir MATCHES "^example/.")
        message(FATAL_ERROR "Web catalog: source directory must be below example/")
      endif()
      _loka_web_output_spec("${_exportName}" "${_outputDir}")
      file(RELATIVE_PATH _js "${CMAKE_BINARY_DIR}"
        "${_RUNTIME_OUTPUT_DIRECTORY}/${_PREFIX}${_OUTPUT_NAME}${_SUFFIX}")
      _loka_web_relative_path("${_js}")
      get_filename_component(_name "${_sourceDir}" NAME)
      set(_id "${_target}")

      string(TOUPPER "${CMAKE_BUILD_TYPE}" _config)
      foreach(_property IN LISTS _output_properties)
        get_target_property(_actual "${_target}" ${_property})
        if(NOT "${_actual}" STREQUAL "${_${_property}}")
          message(FATAL_ERROR "Web catalog: output policy override: ${_property}")
        endif()
      endforeach()
      foreach(_property RUNTIME_OUTPUT_NAME OUTPUT_NAME_${_config} ${_config}_OUTPUT_NAME
          RUNTIME_OUTPUT_NAME_${_config} RUNTIME_OUTPUT_DIRECTORY_${_config}
          ${_config}_POSTFIX)
        get_property(_set TARGET "${_target}" PROPERTY ${_property} SET)
        if(_set)
          message(FATAL_ERROR "Web catalog: output policy override: ${_property}")
        endif()
      endforeach()
      string(APPEND _catalog "${_separator}{")
      set(_field_separator "")
      foreach(_field id name target exportName sourceDir js)
        _loka_web_json_string(_encoded "${_${_field}}")
        string(APPEND _catalog "${_field_separator}\"${_field}\":${_encoded}")
        set(_field_separator ",")
      endforeach()
      string(APPEND _catalog "}")
      set(_separator ",")
    endforeach()
  endif()
  string(APPEND _catalog "]}\n")
  file(WRITE "${CMAKE_BINARY_DIR}/loka-web-apps.json" "${_catalog}")
endfunction()

function(loka_add_web_app TARGET EXPORT_NAME)
  add_executable(${TARGET} ${ARGN} ${LOKA_WEB_RAIL_DIR}/entry/WebEntry.cpp)
  target_include_directories(${TARGET} PRIVATE ${LOKA_WEB_RAIL_DIR}/entry)
  target_link_libraries(${TARGET} PRIVATE LokaWebCore)
  target_compile_options(${TARGET} PRIVATE -UTEST_BUILD -ULOKA_DIAG -fno-exceptions -fno-rtti -Werror)
  set_target_properties(${TARGET} PROPERTIES
    CXX_STANDARD 98 CXX_STANDARD_REQUIRED YES)
  _loka_web_output_spec("${EXPORT_NAME}" "${CMAKE_CURRENT_BINARY_DIR}")
  foreach(_property IN LISTS _output_properties)
    set_property(TARGET ${TARGET} PROPERTY ${_property} "${_${_property}}")
  endforeach()
  _loka_web_register("${TARGET}" "${EXPORT_NAME}" "${CMAKE_CURRENT_BINARY_DIR}")
  loka_enable_warnings(${TARGET})
  target_link_options(${TARGET} PRIVATE
    -sSTACK_SIZE=8MB -sALLOW_MEMORY_GROWTH=1 -sEXIT_RUNTIME=0
    -sMODULARIZE=1 -sEXPORT_NAME=${EXPORT_NAME} -sENVIRONMENT=web
    -sDYNAMIC_EXECUTION=0 -sEXPORT_ES6=0 -sINVOKE_RUN=1 -sWASM_ASYNC_COMPILATION=1
    "-sINCOMING_MODULE_JS_API=['locateFile']"
    "--js-library=${LOKA_WEB_RAIL_DIR}/js/library.js"
    "--pre-js=${LOKA_WEB_RAIL_DIR}/js/style-vocab.js"
    "--pre-js=${LOKA_WEB_RAIL_DIR}/js/text.js"
    "--post-js=${LOKA_WEB_RAIL_DIR}/js/api.js")
  set_property(TARGET ${TARGET} APPEND PROPERTY LINK_DEPENDS
    ${LOKA_WEB_RAIL_DIR}/js/library.js
    ${LOKA_WEB_RAIL_DIR}/js/style-vocab.js
    ${LOKA_WEB_RAIL_DIR}/js/text.js
    ${LOKA_WEB_RAIL_DIR}/js/api.js)
endfunction()
