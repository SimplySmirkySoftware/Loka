{
  "name": "loka-preview",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\" && tsc -p .",
    "check": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/vscode": "1.140.0",
    "typescript": "5.9.3"
  },
  "displayName": "Loka Preview",
  "description": "Preview a Loka Web module in VS Code.",
  "publisher": "simplysmirkysoftware",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.143.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "loka.preview.open",
        "title": "Open Preview",
        "category": "Loka"
      },
      {
        "command": "loka.preview.build",
        "title": "Build",
        "category": "Loka"
      },
      {
        "command": "loka.preview.reload",
        "title": "Reload",
        "category": "Loka"
      },
      {
        "command": "loka.preview.selectExample",
        "title": "Select Example",
        "category": "Loka"
      },
      {
        "command": "loka.preview.configure",
        "title": "Configure",
        "category": "Loka"
      },
      {
        "command": "loka.preview.selectSkin",
        "title": "Select Skin",
        "category": "Loka"
      }
    ],
    "configuration": {
      "title": "Loka Preview",
      "properties": {
        "loka.preview.buildDirectory": {
          "type": "string",
          "default": "build/wasm/web",
          "scope": "resource",
          "description": "Build directory, absolute or relative to the first workspace folder, containing loka-web-apps.json."
        },
        "loka.preview.configureCommand": {
          "type": "string",
          "default": "emcmake cmake --preset web",
          "scope": "resource",
          "description": "Shell command that configures the selected build directory. The task environment must provide emsdk."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Preview runs workspace JavaScript and Wasm; Configure runs a workspace shell command and Build runs CMake."
    },
    "virtualWorkspaces": false
  }
}
