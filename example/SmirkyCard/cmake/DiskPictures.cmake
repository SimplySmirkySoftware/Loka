# Parallel grammar to disk-scripts.txt; binary twins bypass DiskScriptAscii.
function(smirkycard_read_disk_pictures directory output)
  set(manifest "${directory}/disk-pictures.txt")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
  file(STRINGS "${manifest}" lines)
  set(pictures)
  foreach(line IN LISTS lines)
    string(STRIP "${line}" stem)
    if(stem STREQUAL "" OR stem MATCHES "^#")
      continue()
    endif()
    string(LENGTH "${stem}" length)
    if(NOT stem MATCHES "^[A-Za-z0-9_-]+$" OR length GREATER 26)
      message(FATAL_ERROR "Invalid SmirkyCard picture stem: ${stem}")
    endif()
    foreach(suffix IN ITEMS PICT PNG)
      if(NOT EXISTS "${directory}/assets/${stem}.${suffix}")
        message(FATAL_ERROR "Missing SmirkyCard picture twin: ${stem}.${suffix}")
      endif()
    endforeach()
    list(APPEND pictures "${stem}")
  endforeach()
  set(${output} "${pictures}" PARENT_SCOPE)
endfunction()
